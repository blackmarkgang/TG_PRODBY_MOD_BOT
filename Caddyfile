{$APP_DOMAIN} {
    encode zstd gzip

    handle_path /api/* {
        header Cache-Control "no-store"
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy admin-web:80
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
}
