APP_ENV=production
APP_NAME=Prod.by Bot

# Public hostname without https://. Create an A record pointing it to the VPS IPv4.
APP_DOMAIN=bot.example.com
PUBLIC_WEBAPP_URL=https://bot.example.com
API_BASE_URL=https://bot.example.com/api
CORS_ORIGINS=https://bot.example.com

BOT_TOKEN=replace_me
TELEGRAM_GROUP_ID=replace_me
MODERATION_TIMEOUT_SECONDS=60

# Use the same URL-safe password in all three values.
POSTGRES_DB=prodby
POSTGRES_USER=prodby
POSTGRES_PASSWORD=replace_with_random_hex
DATABASE_URL=postgresql+asyncpg://prodby:replace_with_random_hex@postgres:5432/prodby
SYNC_DATABASE_URL=postgresql+psycopg://prodby:replace_with_random_hex@postgres:5432/prodby

# The first ID becomes owner only on a brand-new database; others become administrators.
ADMIN_IDS=1692840322,7824886025,263582171,5630900291

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
